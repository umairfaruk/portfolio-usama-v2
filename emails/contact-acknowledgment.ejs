<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="color-scheme" content="dark light" />
  <meta name="supported-color-schemes" content="dark light" />
  <title>Message Received</title>
  <style>
    body, table, td { font-family: -apple-system, 'Segoe UI', Helvetica, Arial, sans-serif; }
    body { margin: 0; padding: 0; background-color: #050b18; }
    table { border-collapse: collapse; }
    a { text-decoration: none; }
    @media screen and (max-width: 620px) {
      .email-container { width: 100% !important; }
      .px-mobile { padding-left: 24px !important; padding-right: 24px !important; }
    }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#050b18;">

  <div style="display:none; max-height:0; max-width:0; overflow:hidden; opacity:0; mso-hide:all;">
    Thanks for reaching out, <%= name %> — your message has been received.
  </div>

  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#050b18;">
    <tr>
      <td align="center" style="padding: 48px 16px;">
        <table role="presentation" class="email-container" width="560" cellpadding="0" cellspacing="0" border="0" style="width:560px; max-width:560px;">

          <!-- Accent bar -->
          <tr>
            <td height="4" bgcolor="#00d2ff" style="background-image: linear-gradient(90deg, #00d2ff, #a855f7); border-radius:20px 20px 0 0; font-size:0; line-height:0;">&nbsp;</td>
          </tr>

          <!-- Card -->
          <tr>
            <td style="background-color:#0a1628; border:1px solid #16264a; border-top:none; border-radius:0 0 20px 20px; padding: 40px 36px;" class="px-mobile">

              <!-- Wordmark -->
              <p style="margin:0 0 32px; font-family: Arial, sans-serif; font-size:14px; font-weight:700; color:#00d2ff;">Usama Asif</p>

              <p style="margin:0 0 8px; font-family: 'Courier New', monospace; font-size:11px; font-weight:700; letter-spacing:.2em; text-transform:uppercase; color:#64748b;">Message Received</p>
              <h1 style="margin:0 0 18px; font-family: Arial, sans-serif; font-size:22px; line-height:1.35; font-weight:800; color:#ffffff;">Thanks for reaching out, <%= name %>!</h1>

              <p style="margin:0 0 24px; font-family: Arial, sans-serif; font-size:14px; line-height:1.7; color:#cbd5e1;">
                Your message has landed safely in my inbox. I read every inquiry personally and typically reply within 24 hours — often sooner.
              </p>

              <!-- Submission summary -->
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-left:2px solid #00d2ff; margin-bottom:28px;">
                <tr>
                  <td style="padding:2px 0 2px 18px;">
                    <p style="margin:0 0 6px; font-family: Arial, sans-serif; font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#64748b;">Subject</p>
                    <p style="margin:0 0 14px; font-family: Arial, sans-serif; font-size:14px; font-weight:600; color:#e2e8f0;"><%= subject %></p>
                    <p style="margin:0 0 6px; font-family: Arial, sans-serif; font-size:10px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:#64748b;">Your Message</p>
                    <p style="margin:0; font-family: Arial, sans-serif; font-size:14px; line-height:1.7; color:#cbd5e1;"><%= messageExcerpt %></p>
                  </td>
                </tr>
              </table>

              <p style="margin:0 0 4px; font-family: Arial, sans-serif; font-size:14px; line-height:1.7; color:#cbd5e1;">Talk soon,</p>
              <p style="margin:0 0 2px; font-family: Arial, sans-serif; font-size:15px; font-weight:700; color:#ffffff;">Usama Asif</p>
              <p style="margin:0; font-family: Arial, sans-serif; font-size:13px; color:#64748b;">Full-Stack Web Developer &amp; AI Integration Specialist</p>

              <p style="margin:36px 0 0; font-family: Arial, sans-serif; font-size:12px; line-height:1.6; color:#5b6b89;">
                This is an automated confirmation — no need to reply unless you&rsquo;d like to add anything.
              </p>
            </td>
          </tr>

          <tr>
            <td align="center" style="padding: 20px 16px 0;">
              <p style="margin:0; font-family: Arial, sans-serif; font-size:11px; color:#3d4d6b;">&copy; <%= year %> Usama Asif</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
